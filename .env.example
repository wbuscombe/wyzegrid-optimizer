# wyzegrid-optimizer environment template — copy to .env and fill in.
# .env is gitignored. Phantom demo mode (PHANTOM_MODE=1) needs NONE of these set.

# --- Frigate ---
# HTTP base URL. Read-only access — this project never writes to Frigate.
FRIGATE_URL=http://192.168.50.6:5000

# Optional: limit ingestion to specific cameras (comma-separated, empty = all).
# OPTIMIZER_CAMERAS=front_yard_cam,front_porch_cam,back_yard_cam,back_deck_cam

# --- Claude ---
# Anthropic API key — used only for the interpretation pass (Haiku, summaries
# in, JSON recommendations out). The optimizer runs without it (rules-only)
# if absent — recommendations come from the deterministic layer with no LLM
# polish. Set to enable the Claude layer.
ANTHROPIC_API_KEY=

# Model + cost guardrails
OPTIMIZER_MODEL=claude-haiku-4-5
# Hard ceiling per analysis run (tokens). Run aborts the Claude call past this.
OPTIMIZER_TOKEN_BUDGET=20000

# --- Demo / dev ---
# PHANTOM_MODE=1 boots the dashboard with synthetic mock data, no Frigate
# polling, no API calls. Required for the demo workflow and CI smoke tests.
PHANTOM_MODE=0

# --- Scheduling ---
# The daily ingest+analyze cycle is anchored to a fixed local wall-clock time so
# it never drifts with restart time or cycle duration. Keep it OUTSIDE the Kometa
# window (03:00–07:00 local). Default 02:00.
OPTIMIZER_RUN_AT_HOUR=2
OPTIMIZER_RUN_AT_MINUTE=0
# IANA timezone used only to render learned garbage/recycling/mail/package
# service windows. UTC is the safe default; set this to the household timezone.
OPTIMIZER_TIMEZONE=UTC
# Legacy rolling cadence — retained for compatibility; the scheduler now uses the
# wall-clock anchor above instead.
OPTIMIZER_INTERVAL_SECONDS=86400

# --- Optional: ZMA status webhook ---
# If set, the optimizer POSTs run-complete events here. No-op if unset.
ZMA_WEBHOOK_URL=

# --- Optional: ntfy failure alert ---
# On a failed nightly run the optimizer publishes an alert to {NTFY_URL}/{NTFY_TOPIC}
# via HTTP Basic auth. The ecosystem ntfy server is deny-all, so ALL FOUR fields
# are required to publish; leave any blank to disable (no-op). Use a topic and a
# credential you are comfortable dedicating to the optimizer.
NTFY_URL=
NTFY_TOPIC=
NTFY_USER=
NTFY_PASS=

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5004

# --- Storage ---
# Where run state + the SQLite DB live. The Docker image sets OPTIMIZER_DATA_DIR=/data; run
# locally both default to ./data. Override only if you keep state elsewhere.
# OPTIMIZER_DATA_DIR=./data
# OPTIMIZER_DB_PATH=./data/optimizer.db
